# Cloudflare credentials for Spider Search indexing.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Dashboard -> Workers & Pages -> Account ID
CLOUDFLARE_ACCOUNT_ID=

# API token with: Account:Read, Workers Scripts:Edit, D1:Edit
CLOUDFLARE_API_TOKEN=

# UUID of the spidersearch D1 database
CLOUDFLARE_D1_DATABASE_ID=